{
  "name": "oh-my-bbff-widgets",
  "version": "1.0.2",
  "engines": {
    "dsh": ">=0.2.2-rc.2"
  },
  "type": "module",
  "description": "Oh-My-BBFF Widgets — family root for DeepSeek Harness: right-sidebar status cards, global notes, the BBFF settings panel with DSH language switching, and the family contract modules register into.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BB-84C/Oh-My-BBFF.git",
    "directory": "packages/oh-my-bbff-widgets"
  },
  "homepage": "https://github.com/BB-84C/Oh-My-BBFF#readme",
  "bugs": {
    "url": "https://github.com/BB-84C/Oh-My-BBFF/issues"
  },
  "keywords": [
    "oh-my-bbff",
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "widgets",
    "sidebar",
    "dashboard"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "scripts/check-package.mjs"
  ],
  "scripts": {
    "prepack": "node scripts/check-package.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "bbff": {
    "contract": 1,
    "id": "widgets",
    "title": "Oh-My-BBFF Widgets",
    "root": true
  }
}

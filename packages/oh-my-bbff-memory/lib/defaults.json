{
  "settingsVersion": 4,
  "source": "Oh-My-BBFF Memory shipped defaults",
  "contract": {
    "sourceKind": "plugin:bbff-memory"
  },
  "policies": {
    "reviewInventoryFactor": 1.3,
    "budgetFallbackWindowTokens": 128000,
    "budgetWindowCacheMs": 300000,
    "reviewInventoryScope": "global plus distinct resolved root workspaces in the bound delta; unknown roots are explicitly diagnosed",
    "budgetScope": "one framed Memory batch/snapshot; earlier conversation and compacted context are not retroactively erased",
    "budgetBasis": "the session's current model context window in tokens multiplied by the visible budget ratio; discovered file bytes are only the demand side",
    "modelApplyBoundary": "every request; the Resident session's own model selection (changed in that session) is honored live, Memory fixed mode applies to the next request, and unrelated sessions' model changes or the DSH global default never move the Resident route",
    "memoryDeduplication": "workspace filenames: .dsh/memory first, then configured read directories; shadowed or archived names never reappear through activation; equal trimmed content is deduplicated secondarily",
    "performanceBudgetsMs": {
      "inventory": {
        "cold": 2000,
        "warm": 500
      },
      "dreamStatus": {
        "cold": 500,
        "warm": 100
      },
      "settings": {
        "cold": 500,
        "warm": 250
      },
      "routePreview": {
        "cold": 2000,
        "warm": 500
      },
      "history": {
        "cold": 1000,
        "warm": 500
      },
      "candidates": {
        "cold": 1000,
        "warm": 500
      },
      "dreamDelta": {
        "cold": 2000,
        "warm": 500
      },
      "dreamPage": {
        "cold": 2000,
        "warm": 250
      }
    },
    "mutationLock": "refuse busy immediately; never break another process lock by age",
    "searchDefaultLimit": 8,
    "searchMaxLimit": 30,
    "searchMinQueryChars": 2,
    "searchLineMaxChars": 240,
    "sessionCheckpointOwnedFrames": 128,
    "retryScope": "failed preparation/delivery only; never replay a model turn or failed commit"
  },
  "storage": {
    "homeDefaultDirectory": ".dsh",
    "globalMemoryDirectory": "memory",
    "settingsDirectory": "oh-my-bbff-memory",
    "dreamingDirectory": ".dreaming",
    "candidatesDirectory": ".candidates",
    "historyDirectory": ".history",
    "archiveDirectory": ".archive",
    "residentWorkspaceDirectory": "dreaming",
    "globalInstructionFile": "AGENTS.md",
    "workspaceInstructionFile": "AGENTS.local.md",
    "protectedWorkspaceInstructionFile": "AGENTS.md",
    "mutationLockFile": "mutation.lock",
    "managedSkillRelativePath": "skills/update-memory/SKILL.md",
    "sessionReadCheckpointDirectory": "session-read-models"
  },
  "fields": {
    "defaultMode": {
      "type": "enum",
      "default": "full",
      "options": [
        "full",
        "routed"
      ],
      "group": "injection"
    },
    "injectEnabled": {
      "type": "boolean",
      "default": true,
      "group": "injection"
    },
    "budgetMode": {
      "type": "enum",
      "default": "auto",
      "options": [
        "auto",
        "fixed"
      ],
      "group": "injection"
    },
    "budgetWindowRatio": {
      "type": "number",
      "default": 0.1,
      "min": 0.01,
      "max": 0.5,
      "unit": "percent",
      "group": "injection"
    },
    "budgetFixedBytes": {
      "type": "nullable-integer",
      "default": null,
      "min": 1,
      "max": 134217728,
      "unit": "bytes",
      "group": "injection"
    },
    "workspaceMemoryDirs": {
      "type": "string-list",
      "default": [
        ".dsh/memory",
        ".opencode/memory",
        ".agent/memory"
      ],
      "group": "directories"
    },
    "routeWindowTurns": {
      "type": "integer",
      "default": 3,
      "min": 1,
      "max": 20,
      "group": "router"
    },
    "routeTopK": {
      "type": "integer",
      "default": 2,
      "min": 1,
      "max": 10,
      "group": "router"
    },
    "routeMaxBytes": {
      "type": "integer",
      "default": 122880,
      "min": 16384,
      "max": 524288,
      "unit": "bytes",
      "group": "router"
    },
    "dreamEnabled": {
      "type": "boolean",
      "default": true,
      "group": "dreaming"
    },
    "dreamAutoWake": {
      "type": "boolean",
      "default": true,
      "group": "dreaming"
    },
    "wakeIntervalHours": {
      "type": "number",

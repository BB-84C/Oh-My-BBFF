{
  "name": "oh-my-bbff-scope",
  "version": "1.0.0",
  "engines": {
    "dsh": ">=0.2.2-rc.2"
  },
  "scripts": {
    "prepack": "node scripts/check-package.mjs",
    "check": "node scripts/check-package.mjs"
  },
  "type": "module",
  "description": "Oh-My-BBFF Scope — workspace availability rules for tools, MCP servers and skills, with a settings UI and no model tools.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BB-84C/Oh-My-BBFF.git",
    "directory": "packages/oh-my-bbff-scope"
  },
  "homepage": "https://github.com/BB-84C/Oh-My-BBFF#readme",
  "bugs": {
    "url": "https://github.com/BB-84C/Oh-My-BBFF/issues"
  },
  "keywords": [
    "oh-my-bbff",
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "workspace",
    "mcp",
    "tools",
    "skills"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "scripts/check-package.mjs"
  ],
  "bbff": {
    "contract": 1,
    "id": "scope",
    "title": "Oh-My-BBFF Scope"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}

{
  "name": "oh-my-bbff-hello",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Oh-My-BBFF Hello — minimal example module for the open Oh-My-BBFF SDK: one status card and one BBFF settings section.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "bbff": {
    "contract": 1,
    "id": "hello",
    "title": "Oh-My-BBFF Hello"
  }
}
